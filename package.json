{
  "name": "n8n-nodes-pangolinfo",
  "version": "0.2.0",
  "description": "n8n community nodes for real-time Amazon, Alexa, AI SERP, niche and category data from Pangolinfo.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "amazon",
    "amazon-api",
    "amazon-scraper",
    "ecommerce-data",
    "ai-serp",
    "ai-overview-api",
    "amazon-alexa-api",
    "amazon-niche-api",
    "product-research",
    "pangolinfo"
  ],
  "license": "MIT",
  "homepage": "https://www.pangolinfo.com/amazon-scraper-api/",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pangolin-spg/n8n-nodes-pangolinfo.git"
  },
  "bugs": {
    "url": "https://github.com/Pangolin-spg/n8n-nodes-pangolinfo/issues"
  },
  "author": {
    "name": "PANGOLIN INFO TECH PTE. LTD.",
    "url": "https://www.pangolinfo.com/"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "BRANDING.md",
    "workflow-templates"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PangolinfoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Pangolinfo/Pangolinfo.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "n8n-workflow": "^1.92.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.19"
  }
}
